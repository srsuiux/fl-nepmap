{
  "name": "nepal-flood-landslide-watch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node --env-file=.env.local worker/migrate.ts",
    "worker": "node --env-file=.env.local worker/index.ts",
    "typecheck": "tsc --noEmit",
    "copy:maplibre": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "predev": "npm run copy:maplibre",
    "prebuild": "npm run copy:maplibre"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}